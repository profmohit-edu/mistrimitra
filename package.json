{
  "name": "mistrimitra",
  "version": "1.0.0",
  "description": "MistriMitra: real-time voice agent (Gemini 3.8 Live) that helps plant technicians fix machines in their own language and acts in the CMMS.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"bench/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"bench/*.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "start": "python3 -m http.server 8080",
    "test:e2e": "node --test tests/e2e/*.e2e.js",
    "bench": "node bench/retrieval.bench.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "10.1.0",
    "prettier": "3.8.1",
    "typescript": "7.0.2",
    "playwright": "1.63.0"
  }
}
